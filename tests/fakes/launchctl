#!/usr/bin/env python3
"""Fake `launchctl` for tests. It never loads or unloads a real job.

Each call is appended as a JSON line to $FAKE_CALLS_LOG. When $FAKE_LAUNCHCTL_DB is set, the fake also
tracks which labels are loaded, so a second `bootstrap` fails and a `bootout` of an unloaded job fails,
with the same exit codes as the real command. Without it, every call succeeds.
"""
import json
import os
import plistlib
import sys


def log_call(argv):
    path = os.environ.get("FAKE_CALLS_LOG")
    if path:
        with open(path, "a") as fh:
            fh.write(json.dumps(["launchctl"] + argv) + "\n")


def load(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except FileNotFoundError:
        return []


def save(path, loaded):
    with open(path, "w") as fh:
        json.dump(sorted(set(loaded)), fh)


def main(argv):
    log_call(argv)
    db_path = os.environ.get("FAKE_LAUNCHCTL_DB")
    if not db_path or not argv:
        return 0
    loaded = load(db_path)

    if argv[0] == "bootstrap" and len(argv) == 3:
        try:
            with open(argv[2], "rb") as fh:
                label = plistlib.load(fh)["Label"]
        except (OSError, KeyError, plistlib.InvalidFileException):
            print("Bootstrap failed: 5: Input/output error", file=sys.stderr)
            return 5
        if label in loaded:
            print("Bootstrap failed: 5: Input/output error", file=sys.stderr)
            return 5
        save(db_path, loaded + [label])
        return 0

    if argv[0] == "bootout" and len(argv) == 2:
        parts = argv[1].split("/", 2)
        label = parts[2] if len(parts) == 3 else ""
        if label not in loaded:
            print("Boot-out failed: 3: No such process", file=sys.stderr)
            return 3
        save(db_path, [x for x in loaded if x != label])
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
