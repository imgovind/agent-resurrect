{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imgovind/agent-resurrect/main/docs/json/simulate.schema.json",
  "title": "agent-resurrect simulate --json",
  "description": "What automatic restore would do for every recorded pane (or the one named by --pane-key), checked by the same rules, without a terminal, launching nothing and changing nothing. With assume_restart, recorded agent processes count as stopped, as after a restart. mode is the configured auto_resume (off: the command would be printed, not run).",
  "allOf": [{"$ref": "envelope.schema.json"}],
  "properties": {
    "schema": {"const": "agent-resurrect.simulate/1"},
    "assume_restart": {"type": "boolean"},
    "panes": {"type": "array", "items": {"$ref": "#/$defs/pane_decision"}}
  },
  "if": {"properties": {"ok": {"const": true}}},
  "then": {"required": ["assume_restart", "panes"]},
  "$defs": {
    "pane_decision": {
      "type": "object",
      "required": ["pane", "decision", "reason", "mode", "session"],
      "properties": {
        "pane": {"$ref": "pane.schema.json"},
        "decision": {"enum": ["would-resume", "would-skip", "no-record"]},
        "reason": {"anyOf": [{"$ref": "envelope.schema.json#/$defs/restore_reason"}, {"type": "null"}],
                   "description": "null for no-record"},
        "mode": {"enum": ["countdown", "immediate", "ask", "off"]},
        "session": {"anyOf": [{"$ref": "session.schema.json"}, {"type": "null"}]}
      }
    }
  }
}
